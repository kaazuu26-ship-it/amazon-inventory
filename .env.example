# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-northeast-1

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SHEETS_CREDENTIALS=credentials.json

# Chatwork Configuration
CHATWORK_API_KEY=your_chatwork_api_key_here
CHATWORK_ROOM_ID=your_chatwork_room_id_here

# Amazon Seller Central Configuration
SELLER_CENTRAL_EMAIL=your_seller_central_email_here
SELLER_CENTRAL_PASSWORD=your_seller_central_password_here

# Amazon Selling Partner API (if needed)
AMAZON_ROLE_ARN=your_arn_here
AMAZON_REGION=JP
